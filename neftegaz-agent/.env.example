# Скопируй этот файл в .env и впиши свои значения.
# Никогда не выкладывай .env с реальным ключом никуда публично.

YANDEX_API_KEY=здесь_твой_api_key_из_ai_studio
YANDEX_FOLDER_ID=здесь_id_каталога_folder_id
YANDEX_MODEL=yandexgpt/latest

# Какого провайдера использовать: yandex (по умолчанию) или aitunnel.
LLM_PROVIDER=yandex

# Нужны только если LLM_PROVIDER=aitunnel — российский агрегатор с
# оплатой в рублях (https://aitunnel.ru), доступ к DeepSeek/GPT/Claude
# через тот же OpenAI-совместимый клиент.
AITUNNEL_API_KEY=здесь_твой_ключ_sk-aitunnel-...
AITUNNEL_MODEL=deepseek-r1

# Необязательно: максимум токенов на один ответ модели. Для DeepSeek-R1
# рекомендуется не меньше 50000 (часть токенов уходит на его скрытые
# рассуждения). Для YandexGPT не нужно, оставь пустым.
LLM_MAX_TOKENS=

# Нужен только для бота в MAX (bot_max.py).
# Получить: в мессенджере MAX найти @MasterBot, отправить /create.
MAX_BOT_TOKEN=здесь_токен_бота_из_masterbot

# Нужен только для бота в Telegram (bot_telegram.py).
# Получить: в Telegram найти @BotFather, отправить /newbot.
TELEGRAM_BOT_TOKEN=здесь_токен_бота_из_botfather

# Кому разрешено пользоваться ботом в Telegram — список Telegram ID через
# запятую, без пробелов, например: 123456789,987654321
# Свой ID можно узнать, написав боту команду /myid (работает для всех).
# Если оставить пустым — бот отвечает всем без ограничений.
TELEGRAM_ALLOWED_USER_IDS=

# Нужен только для веб-приложения (app_web.py) — пароль на вход,
# чтобы по ссылке чужие люди не тратили твой баланс Yandex Cloud.
# Придумай любой свой пароль.
APP_PASSWORD=придумай_свой_пароль
