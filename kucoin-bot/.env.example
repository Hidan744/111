# Скопируйте в .env и заполните. Файл .env не коммитится.
# Ключ создаётся в KuCoin: API Management -> Create API.
# Права: ТОЛЬКО "General" + "Spot Trading". НИКОГДА не включайте "Transfer"/"Withdraw".
# Обязательно ограничьте ключ по IP сервера, где запущен бот.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Торговая пара и таймфрейм (1min 3min 5min 15min 30min 1hour 2hour 4hour 6hour 8hour 12hour 1day 1week)
SYMBOL=BTC-USDT
TIMEFRAME=1hour

# Стратегия: пересечение EMA + фильтр тренда + RSI, стопы по ATR
FAST_EMA=12
SLOW_EMA=26
TREND_EMA=200
RSI_PERIOD=14
RSI_MAX=70
ATR_PERIOD=14
STOP_ATR=2.0
TAKE_ATR=4.0
# Трейлинг-стоп в ATR (0 = выключен)
TRAIL_ATR=0

# Риск-менеджмент
# Доля капитала, которой рискуем в одной сделке (до стоп-лосса): 0.01 = 1%
RISK_PER_TRADE=0.01
# Максимальная доля капитала в одной позиции
MAX_POSITION_PCT=0.5
# Дневной лимит убытка: при просадке за сутки на 3% новые сделки не открываются
MAX_DAILY_LOSS=0.03
# Аварийная остановка: при просадке от пика на 15% позиция закрывается, бот останавливается
MAX_DRAWDOWN=0.15
# Максимум USDT, которым бот может распоряжаться в live-режиме
MAX_CAPITAL=100

# Комиссия биржи за сторону (0.001 = 0.1%) и проскальзывание для бэктеста/бумажной торговли
FEE_RATE=0.001
SLIPPAGE=0.0005
# Стартовый баланс бумажной торговли (USDT)
PAPER_BALANCE=1000

# Как часто опрашивать биржу, сек
POLL_SECONDS=20

# Для реальной торговли должно быть ровно "yes" (плюс флаг --confirm в команде)
LIVE_TRADING=no
