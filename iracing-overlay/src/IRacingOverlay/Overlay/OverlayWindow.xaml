<Window x:Class="IRacingOverlay.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iRacing Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid>
        <Canvas x:Name="WidgetCanvas" />

        <Border x:Name="StatusBanner"
                Style="{StaticResource WidgetPanelStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusBannerText"
                       Style="{StaticResource WidgetValueSmallStyle}"
                       Foreground="{StaticResource WarnBrush}" />
        </Border>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Style="{StaticResource WidgetPanelStyle}"
                x:Name="EditHint"
                Visibility="Collapsed">
            <TextBlock Text="Layout unlocked — drag widgets, then lock from the tray icon or Settings"
                       Style="{StaticResource WidgetLabelStyle}"
                       Foreground="{StaticResource AccentBrush}" />
        </Border>
    </Grid>
</Window>
