<UserControl x:Class="IRacingOverlay.Widgets.StandingsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IRacingOverlay.Converters">
    <UserControl.Resources>
        <conv:IsPlayerToBrushConverter x:Key="PlayerBrush" />
    </UserControl.Resources>
    <Border Style="{StaticResource WidgetPanelStyle}">
        <StackPanel>
            <TextBlock Text="Standings" Style="{StaticResource WidgetLabelStyle}" />
            <ItemsControl ItemsSource="{Binding Standings}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Position}"
                                       Foreground="{Binding IsPlayer, Converter={StaticResource PlayerBrush}}"
                                       FontFamily="Consolas" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding DriverName}"
                                       Foreground="{Binding IsPlayer, Converter={StaticResource PlayerBrush}}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding GapSec, StringFormat={}+{0:0.0}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
