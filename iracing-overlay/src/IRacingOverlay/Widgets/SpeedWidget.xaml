<UserControl x:Class="IRacingOverlay.Widgets.SpeedWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource WidgetPanelStyle}">
        <StackPanel>
            <TextBlock Text="Speed" Style="{StaticResource WidgetLabelStyle}" />
            <TextBlock Text="{Binding SpeedDisplay}" Style="{StaticResource WidgetValueStyle}" />
        </StackPanel>
    </Border>
</UserControl>
