<UserControl x:Class="IRacingOverlay.Widgets.DeltaBestWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IRacingOverlay.Converters">
    <UserControl.Resources>
        <conv:DeltaSecondsToTextConverter x:Key="DeltaText" />
        <conv:DeltaSecondsToBrushConverter x:Key="DeltaBrush" />
    </UserControl.Resources>
    <Border Style="{StaticResource WidgetPanelStyle}">
        <StackPanel>
            <TextBlock Text="Delta to Best" Style="{StaticResource WidgetLabelStyle}" />
            <TextBlock Text="{Binding DeltaToBestSec, Converter={StaticResource DeltaText}}"
                       Foreground="{Binding DeltaToBestSec, Converter={StaticResource DeltaBrush}}"
                       Style="{StaticResource WidgetValueStyle}" />
        </StackPanel>
    </Border>
</UserControl>
