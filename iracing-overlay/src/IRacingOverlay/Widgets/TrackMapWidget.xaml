<UserControl x:Class="IRacingOverlay.Widgets.TrackMapWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IRacingOverlay.Converters">
    <UserControl.Resources>
        <conv:LapDistPctToXConverter x:Key="PctToX" />
        <conv:LapDistPctToYConverter x:Key="PctToY" />
        <conv:IsPlayerToBrushConverter x:Key="PlayerBrush" />

        <Style x:Key="CarMarkerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="{Binding IsPlayer, Converter={StaticResource PlayerBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                    <Setter Property="Width" Value="13" />
                    <Setter Property="Height" Value="13" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF4D4F" ShadowDepth="0" BlurRadius="14" Opacity="0.9" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource WidgetPanelStyle}">
        <StackPanel>
            <TextBlock Text="{Binding TrackDisplayName}" Style="{StaticResource WidgetLabelStyle}" />
            <Grid Width="120" Height="120" Margin="0,6,0,0">
                <Ellipse Width="106" Height="106" Stroke="#2A3040" StrokeThickness="9" />
                <ItemsControl ItemsSource="{Binding CarsOnTrack}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding LapDistPct, Converter={StaticResource PctToX}}" />
                            <Setter Property="Canvas.Top" Value="{Binding LapDistPct, Converter={StaticResource PctToY}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Style="{StaticResource CarMarkerStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
