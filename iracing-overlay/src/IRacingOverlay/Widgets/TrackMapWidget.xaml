<UserControl x:Class="IRacingOverlay.Widgets.TrackMapWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IRacingOverlay.Converters">
    <UserControl.Resources>
        <conv:LapDistPctToXConverter x:Key="PctToX" />
        <conv:LapDistPctToYConverter x:Key="PctToY" />
        <conv:IsPlayerToBrushConverter x:Key="PlayerBrush" />
    </UserControl.Resources>
    <Border Style="{StaticResource WidgetPanelStyle}">
        <StackPanel>
            <TextBlock Text="{Binding TrackDisplayName}" Style="{StaticResource WidgetLabelStyle}" />
            <Grid Width="120" Height="120" Margin="0,4,0,0">
                <Ellipse Width="110" Height="110" Stroke="#33FFFFFF" StrokeThickness="2" />
                <ItemsControl ItemsSource="{Binding CarsOnTrack}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding LapDistPct, Converter={StaticResource PctToX}}" />
                            <Setter Property="Canvas.Top" Value="{Binding LapDistPct, Converter={StaticResource PctToY}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10" Fill="{Binding IsPlayer, Converter={StaticResource PlayerBrush}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
