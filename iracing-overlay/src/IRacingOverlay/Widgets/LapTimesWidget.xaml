<UserControl x:Class="IRacingOverlay.Widgets.LapTimesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IRacingOverlay.Converters">
    <UserControl.Resources>
        <conv:SecondsToLapTimeConverter x:Key="LapTime" />
    </UserControl.Resources>
    <Border Style="{StaticResource WidgetPanelStyle}">
        <StackPanel>
            <TextBlock Text="Lap Times" Style="{StaticResource WidgetLabelStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Current" Style="{StaticResource WidgetLabelStyle}" />
                    <TextBlock Text="{Binding LapCurrentTimeSec, Converter={StaticResource LapTime}}"
                               Style="{StaticResource WidgetValueSmallStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Last" Style="{StaticResource WidgetLabelStyle}" />
                    <TextBlock Text="{Binding LapLastTimeSec, Converter={StaticResource LapTime}}"
                               Style="{StaticResource WidgetValueSmallStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Best" Style="{StaticResource WidgetLabelStyle}" />
                    <TextBlock Text="{Binding LapBestTimeSec, Converter={StaticResource LapTime}}"
                               Style="{StaticResource WidgetValueSmallStyle}"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
