<Window x:Class="IRacingOverlay.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iRacing Overlay — Settings"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1E24"
        ResizeMode="CanMinimize">
    <StackPanel Margin="16">
        <TextBlock Text="Widgets" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
        <CheckBox x:Name="ChkSpeed" Content="Speed" Foreground="White" Margin="0,2" />
        <CheckBox x:Name="ChkRpmGear" Content="RPM / Gear" Foreground="White" Margin="0,2" />
        <CheckBox x:Name="ChkFuel" Content="Fuel Level" Foreground="White" Margin="0,2" />
        <CheckBox x:Name="ChkLapTimes" Content="Lap Times" Foreground="White" Margin="0,2" />
        <CheckBox x:Name="ChkDeltaBest" Content="Delta to Best" Foreground="White" Margin="0,2" />
        <CheckBox x:Name="ChkTireTemps" Content="Tire Temps" Foreground="White" Margin="0,2" />
        <CheckBox x:Name="ChkPosition" Content="Position" Foreground="White" Margin="0,2" />
        <CheckBox x:Name="ChkTrackMap" Content="Track Map" Foreground="White" Margin="0,2" />
        <CheckBox x:Name="ChkStandings" Content="Standings" Foreground="White" Margin="0,2" />

        <Separator Margin="0,12" />

        <TextBlock Text="Units" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RadioKmh" Content="km/h" GroupName="Units" Foreground="White" Margin="0,0,16,0" />
            <RadioButton x:Name="RadioMph" Content="mph" GroupName="Units" Foreground="White" />
        </StackPanel>

        <Separator Margin="0,12" />

        <CheckBox x:Name="ChkUseMockData" Content="Use mock telemetry (test without iRacing running)"
                  Foreground="White" Margin="0,2" />
        <TextBlock Text="Requires restarting the app to take effect." Foreground="#88FFFFFF" FontSize="10" Margin="20,0,0,0" />

        <Separator Margin="0,12" />

        <Button x:Name="BtnToggleLock" Content="Lock layout" Margin="0,0,0,8" Padding="8,4" Click="OnToggleLock" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Padding="14,4" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="Close" Padding="14,4" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
